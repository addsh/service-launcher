# Copy this to terraform.tfvars and edit. terraform.tfvars is gitignored
# since it holds your own config, not a template.

region      = "ap-south-1"
name        = "launcher"
domain_name = "example.internal"

# Leave empty to run HTTP only. Set to an ACM certificate ARN to add an
# HTTPS listener on both ALBs.
certificate_arn = ""

# Both cost money. See the README cost table before turning either on.
enable_nat_gateway   = false
enable_ssm_endpoints = false
create_database      = false

services = {
  # Minimal: only the key is required. Everything else falls back to the
  # defaults in variables.tf (port 80, health check on /, exposure public,
  # one t3.micro instance scaling between 1 and 3).
  orders-api = {}

  # Fully specified.
  payments-api = {
    port              = 8080
    health_check_path = "/healthz"
    host_header       = "payments.example.internal"
    exposure          = "public"
    instance_type     = "t3.small"
    min_size          = 2
    max_size          = 4
    hosted_zone_id    = "Z1234567890ABC"
    # ec2 or ecs, defaults to ec2. ecs uses modules/ecs-service instead of
    # modules/service: a Fargate task and service behind the same shared
    # ALB. Set enable_nat_gateway first, since a task in the private
    # subnets has no other route to pull its image.
    compute = "ec2"
    # Creates a dedicated encrypted PostgreSQL instance for this service,
    # with credentials in Secrets Manager. Defaults to false.
    database = true
    # Creates a dedicated single-node encrypted Valkey cluster for this
    # service. Defaults to false.
    cache = true
  }

  # Internal: routed through the internal ALB instead of the public one, so
  # it is reachable only from inside the VPC.
  reconciliation-worker = {
    exposure = "internal"
  }
}
